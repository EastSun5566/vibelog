{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/.vibelog/**",
    "packages/core/template/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "docs/.vitepress/config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        ".github/scripts/container-smoke.mjs",
        "e2e/fixture-server.ts",
        "e2e/**/*.spec.ts"
      ],
      "project": [
        "docs/.vitepress/**/*.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        ".github/scripts/container-smoke.mjs",
        "e2e/tsconfig.json",
        "e2e/**/*.ts"
      ]
    },
    "packages/core": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["@astrojs/rss"]
    },
    "packages/app": {
      "entry": ["src/main.ts", "src/backup.ts", "src/beta-funnel.ts", "src/styles/app.css", "tests/**/*.test.ts", "tests/runtime-image-smoke.mjs", "drizzle.config.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.ts", "tests/runtime-image-smoke.mjs", "drizzle.config.ts"]
    }
  }
}
