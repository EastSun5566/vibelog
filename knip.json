{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/.vibelog/**",
    "packages/core/template/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "vitest.config.ts",
        "playwright.config.ts",
        ".github/scripts/container-smoke.mjs",
        ".github/scripts/guard-pulumi-preview.mjs",
        ".github/scripts/guard-maintenance-stage.mjs",
        ".github/scripts/guard-maintenance-stage.test.mjs",
        ".github/scripts/check-design-v2-audit.mjs",
        ".github/scripts/check-design-v2-audit.test.mjs",
        "e2e/run-local.mjs",
        "e2e/**/*.spec.ts",
        ".github/scripts/cli-pack-smoke.mjs",
        ".github/scripts/core-pack-smoke.mjs",
        ".github/scripts/core-pack-consumer.mjs",
        ".github/scripts/check-core-release.mjs"
      ],
      "project": [
        "vitest.config.ts",
        "playwright.config.ts",
        ".github/scripts/container-smoke.mjs",
        ".github/scripts/guard-pulumi-preview.mjs",
        ".github/scripts/guard-maintenance-stage.mjs",
        ".github/scripts/guard-maintenance-stage.test.mjs",
        ".github/scripts/check-design-v2-audit.mjs",
        ".github/scripts/check-design-v2-audit.test.mjs",
        "e2e/run-local.mjs",
        "e2e/tsconfig.json",
        "e2e/**/*.ts",
        ".github/scripts/cli-pack-smoke.mjs",
        ".github/scripts/core-pack-smoke.mjs",
        ".github/scripts/core-pack-consumer.mjs",
        ".github/scripts/check-core-release.mjs"
      ],
      "ignoreBinaries": ["pulumi"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "tests/**/*.test.ts", "scripts/build-math.mjs", "scripts/math-bundle-smoke.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/build-math.mjs", "scripts/math-bundle-smoke.mjs"],
      "ignoreDependencies": ["@astrojs/rss"]
    },
    "packages/app": {
      "entry": ["src/main.ts", "src/web-main.ts", "src/worker-main.ts", "src/migrate.ts", "src/migrate-design-v2.ts", "src/browser/main.ts", "src/browser/analytics.ts", "src/styles/app.css", "scripts/*.ts", "tests/**/*.test.ts", "drizzle.config.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/*.ts", "tests/**/*.ts", "drizzle.config.ts"]
    },
    "packages/edge": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/main.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/infra": {
      "entry": ["src/index.ts", "tests/**/*.test.{ts,mjs}"],
      "project": ["src/**/*.ts", "tests/**/*.{ts,mjs,js}"]
    }
  }
}
