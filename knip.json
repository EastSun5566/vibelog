{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/dist/**",
    "**/coverage/**",
    "**/.vibelog/**",
    "packages/core/template/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "vitest.config.ts",
        "playwright.config.ts",
        ".github/scripts/container-smoke.mjs",
        ".github/scripts/guard-pulumi-preview.mjs",
        "e2e/run-local.mjs",
        "e2e/**/*.spec.ts"
      ],
      "project": [
        "vitest.config.ts",
        "playwright.config.ts",
        ".github/scripts/container-smoke.mjs",
        ".github/scripts/guard-pulumi-preview.mjs",
        "e2e/run-local.mjs",
        "e2e/tsconfig.json",
        "e2e/**/*.ts"
      ],
      "ignoreBinaries": ["pulumi"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["@astrojs/rss"]
    },
    "packages/app": {
      "entry": ["src/main.ts", "src/web-main.ts", "src/worker-main.ts", "src/migrate.ts", "src/styles/app.css", "tests/**/*.test.ts", "drizzle.config.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.ts", "drizzle.config.ts"]
    },
    "packages/edge": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/infra": {
      "entry": ["src/index.ts", "tests/**/*.test.{ts,mjs}"],
      "project": ["src/**/*.ts", "tests/**/*.{ts,mjs,js}"]
    }
  }
}
