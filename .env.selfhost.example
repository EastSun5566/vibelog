# Pin a released image. Prefer an immutable digest for upgrades and rollbacks.
VIBELOG_IMAGE=ghcr.io/OWNER/vibelog-app:VERSION

# Public hostnames. Route both hosts and *.app.example.com to 127.0.0.1:3000.
APP_ORIGIN=https://app.example.com
PREVIEW_ORIGIN=https://preview.app.example.com
VIBELOG_BIND_PORT=3000

# The bundled PostgreSQL service. Use URL-safe credentials in connection URLs.
POSTGRES_DB=vibelog
POSTGRES_USER=vibelog
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://vibelog:replace-with-a-long-url-safe-password@postgres:5432/vibelog
DATABASE_MIGRATION_URL=postgresql://vibelog:replace-with-a-long-url-safe-password@postgres:5432/vibelog

# The bundled private MinIO service. These credentials are not exposed publicly.
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=vibelog
OBJECT_STORE_ACCESS_KEY_ID=replace-with-a-long-access-key
OBJECT_STORE_SECRET_ACCESS_KEY=replace-with-a-long-secret-key
OBJECT_STORE_FORCE_PATH_STYLE=true

# Authentication and transactional email.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="VibeLog <login@send.example.com>"
EMAIL_REPLY_TO=support@example.com

# AI provider. Set the key that matches VIBELOG_AI_PROVIDER.
VIBELOG_AI_PROVIDER=openai
VIBELOG_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Lower values reduce latency at the cost of more PostgreSQL polling.
OPERATION_POLL_INTERVAL_MS=1000
