NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_ROOT=../../.vibelog

# Local wildcard domain. Preview and user blog hosts are derived from this.
APP_ORIGIN=http://app.localtest.me:3000
BETTER_AUTH_SECRET=

VIBELOG_AI_USER_DAILY_LIMIT=20
VIBELOG_AI_GLOBAL_DAILY_LIMIT=200
VIBELOG_AI_PROVIDER=groq
VIBELOG_AI_MODEL=openai/gpt-oss-120b

# Other optional pi-ai providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENCODE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
