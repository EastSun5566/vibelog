{
  "name": "vibelog-monorepo",
  "version": "0.5.0-beta.2",
  "private": true,
  "description": "Bring your own content with some vibes ✨",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/vibelog.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter @vibelog/app dev",
    "typecheck": "pnpm --filter @vibelog/core build && pnpm --filter @vibelog/app build && tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && pnpm -r --filter './packages/*' typecheck",
    "test": "pnpm --filter @vibelog/core build && vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "pnpm --filter @vibelog/core build && vitest run --coverage",
    "lint": "pnpm --filter @vibelog/core build && oxlint --type-aware --deny-warnings .",
    "lint:fix": "pnpm --filter @vibelog/core build && oxlint --type-aware --fix .",
    "knip": "knip --no-config-hints --include files,dependencies,devDependencies,unlisted,binaries",
    "db:check": "pnpm --filter @vibelog/app db:check",
    "check": "pnpm lint && pnpm knip && pnpm db:check && pnpm typecheck && pnpm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "keywords": [
    "blog-builder",
    "content",
    "markdown",
    "vibe",
    "ai",
    "styling",
    "hosting"
  ],
  "author": "Michael Wang <michael19920327@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac",
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "^24.0.0",
    "hono": "^4.12.30",
    "@vitest/coverage-v8": "^3.2.7",
    "knip": "6.26.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "7.0.2",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.7"
  }
}
