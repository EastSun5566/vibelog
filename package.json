{
  "name": "vibelog-monorepo",
  "version": "0.12.0",
  "private": true,
  "description": "Bring your own content with some vibes ✨",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/vibelog.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter @vibelog/app dev",
    "typecheck": "pnpm --filter @vibelog/core build && pnpm --filter @vibelog/app build && pnpm --filter @vibelog/cli build && tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && pnpm -r --filter './packages/*' typecheck",
    "test": "pnpm --filter @vibelog/core build && vitest run",
    "test:e2e": "node e2e/run-local.mjs",
    "test:coverage": "pnpm --filter @vibelog/core build && vitest run --coverage",
    "format": "oxfmt '**/*.{ts,tsx,mts,cts}'",
    "format:check": "oxfmt --check '**/*.{ts,tsx,mts,cts}'",
    "lint": "pnpm --filter @vibelog/core build && pnpm --filter @vibelog/cli build && oxlint --type-aware --deny-warnings .",
    "lint:fix": "pnpm --filter @vibelog/core build && pnpm --filter @vibelog/cli build && oxlint --type-aware --fix .",
    "knip": "knip --no-config-hints --include files,dependencies,devDependencies,unlisted,binaries",
    "db:check": "pnpm --filter @vibelog/app db:check",
    "db:migrate": "pnpm --filter @vibelog/app db:migrate",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm db:check && pnpm typecheck && pnpm test"
  },
  "keywords": [
    "blog-builder",
    "content",
    "markdown",
    "vibe",
    "ai",
    "styling",
    "hosting"
  ],
  "author": "Michael Wang <michael19920327@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "hono": "^4.13.13",
    "knip": "6.26.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
