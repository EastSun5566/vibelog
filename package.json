{
  "name": "vibelog-monorepo",
  "version": "0.4.1-beta.2",
  "private": true,
  "description": "Bring your own content with some vibes ✨",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm --filter vibelog dev",
    "typecheck": "pnpm --filter @vibelog/core build && tsc -p tsconfig.json && pnpm -r --filter './packages/*' typecheck",
    "test": "pnpm --filter @vibelog/core build && vitest run",
    "test:coverage": "pnpm --filter @vibelog/core build && vitest run --coverage",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix .",
    "knip": "knip --no-config-hints --include files,dependencies,devDependencies,unlisted,binaries",
    "check": "pnpm lint && pnpm knip && pnpm typecheck && pnpm test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "keywords": [
    "blog-builder",
    "content",
    "markdown",
    "vibe",
    "ai",
    "styling",
    "cli"
  ],
  "author": "Michael Wang <michael19920327@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "knip": "6.26.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "7.0.2",
    "vitepress": "^1.6.3",
    "vitest": "^3.2.7"
  }
}
