{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/*/src",
    "tests",
    "docs/.vitepress/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "coverage", "packages/*/dist", "packages/*/node_modules"]
}
