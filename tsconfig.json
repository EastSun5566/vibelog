{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@vibelog/core": ["./packages/core/src/index.ts"]
    },
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "examples/**/*.ts",
    "docs/.vitepress/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "coverage", "node_modules"]
}
