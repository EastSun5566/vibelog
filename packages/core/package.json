{
  "name": "@vibelog/core",
  "version": "0.4.1-beta.0",
  "description": "Bring your own content with some vibes ✨ - Core library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/content": {
      "types": "./dist/adapters/content/index.d.ts",
      "import": "./dist/adapters/content/index.js"
    },
    "./adapters/ai": {
      "types": "./dist/adapters/ai/index.d.ts",
      "import": "./dist/adapters/ai/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "build": "rm -rf dist && tsdown",
    "lint": "eslint --fix src"
  },
  "keywords": [
    "blog-builder",
    "content",
    "markdown",
    "vibe",
    "ai",
    "styling"
  ],
  "author": "Michael Wang <michael19920327@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.19",
    "@ai-sdk/openai": "^1.3.22",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.1",
    "@notionhq/client": "^3.1.3",
    "@openrouter/ai-sdk-provider": "^0.7.1",
    "ai": "^4.3.16",
    "astro": "6.4.8",
    "fs-extra": "^11.3.0",
    "gray-matter": "^4.0.3",
    "kleur": "^4.1.5",
    "notion-to-md": "^3.1.9",
    "ollama-ai-provider": "^1.2.0",
    "postcss": "^8.5.4",
    "zod": "^3.25.55"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.30",
    "tsdown": "^0.12.7",
    "typescript": "^5.8.3"
  }
}
