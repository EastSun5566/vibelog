{
  "name": "@vibelog/core",
  "version": "0.8.0",
  "private": true,
  "description": "Bring your own content with some vibes ✨ - Core library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/vibelog.git",
    "directory": "packages/core"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "blog-builder",
    "content",
    "markdown",
    "vibe",
    "ai",
    "styling"
  ],
  "author": "Michael Wang <michael19920327@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@earendil-works/pi-ai": "0.84.4",
    "astro": "7.3.1",
    "fs-extra": "^11.3.0",
    "gray-matter": "^4.0.3",
    "kleur": "^4.1.5",
    "mdast-util-from-markdown": "2.0.2",
    "zod": "^3.25.55"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
