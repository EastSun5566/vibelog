---
import HeaderLink from "./HeaderLink.astro";

import { SITE_TITLE } from "../consts";
import { text } from "../localization";

interface Props {
  hasTags?: boolean;
  variant?: "compact" | "centered" | "masthead";
}

const { hasTags = false, variant = "compact" } = Astro.props;
---

<header class={`site-header variant-${variant}`} data-design-target="site.header" data-design-role="site-header">
  <nav aria-label={text.primaryNavigation}>
    <a class="site-title" href="/">{SITE_TITLE}</a>
    <ul class="site-nav-links" role="list">
      <li><HeaderLink href="/">{text.home}</HeaderLink></li>
      <li><HeaderLink href="/blog">{text.posts}</HeaderLink></li>
      <li><HeaderLink href="/search">{text.search}</HeaderLink></li>
      {hasTags && <li><HeaderLink href="/tags">{text.tags}</HeaderLink></li>}
    </ul>
  </nav>
</header>
