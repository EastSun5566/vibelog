---
import HeaderLink from "./HeaderLink.astro";

import { SITE_TITLE } from "../consts";

interface Props {
  hasTags?: boolean;
}

const { hasTags = false } = Astro.props;
---

<header class="site-header">
  <nav aria-label="主要導覽">
    <a class="site-title" href="/">{SITE_TITLE}</a>
    <ul class="site-nav-links" role="list">
      <li><HeaderLink href="/">首頁</HeaderLink></li>
      <li><HeaderLink href="/blog">文章</HeaderLink></li>
      {hasTags && <li><HeaderLink href="/tags">主題</HeaderLink></li>}
    </ul>
  </nav>
</header>
