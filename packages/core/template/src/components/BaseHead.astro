---
import { SITE_DESCRIPTION, SITE_LANGUAGE, SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  kind?: "website" | "article";
  publishedAt?: Date;
  modifiedAt?: Date;
  tags?: string[];
  articleTitle?: string;
  authorName?: string;
  robots?: string;
  searchAssets?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  kind = "website",
  publishedAt,
  modifiedAt,
  tags = [],
  articleTitle,
  authorName,
  robots,
  searchAssets = false,
} = Astro.props;
const markdownURL = kind === "article" ? new URL("index.md", canonicalURL) : undefined;
const structuredData = kind === "article" && publishedAt
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: articleTitle ?? title,
      description,
      url: canonicalURL.href,
      mainEntityOfPage: canonicalURL.href,
      datePublished: publishedAt.toISOString(),
      ...(modifiedAt && modifiedAt > publishedAt ? { dateModified: modifiedAt.toISOString() } : {}),
      inLanguage: SITE_LANGUAGE,
      ...(authorName ? { author: { "@type": "Person", name: authorName } } : {}),
      ...(tags.length ? { keywords: tags } : {}),
      isPartOf: { "@type": "Blog", name: SITE_TITLE, url: new URL("/", Astro.site).href },
    }
  : kind === "website" && Astro.url.pathname === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "Blog",
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: canonicalURL.href,
        inLanguage: SITE_LANGUAGE,
        ...(authorName ? { author: { "@type": "Person", name: authorName } } : {}),
      }
    : undefined;
const structuredDataJSON = structuredData && JSON.stringify(structuredData).replaceAll("<", "\\u003c");
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="stylesheet" href="/global.css" />
<link rel="stylesheet" href="/theme.css" />
<link rel="stylesheet" href="/syntax.css" />
{searchAssets && <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />}
{searchAssets && <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>}
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("/rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{markdownURL && <link rel="alternate" type="text/markdown" href={markdownURL} />}
{markdownURL && <link rel="describedby" href={new URL("/llms.txt", Astro.site)} />}
{robots && <meta name="robots" content={robots} />}
{structuredDataJSON && <script type="application/ld+json" set:html={structuredDataJSON} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={kind} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={SITE_LANGUAGE} />
{
  kind === "article" && publishedAt && (
    <meta property="article:published_time" content={publishedAt.toISOString()} />
  )
}
{
  kind === "article" && modifiedAt && publishedAt && modifiedAt > publishedAt && (
    <meta property="article:modified_time" content={modifiedAt.toISOString()} />
  )
}
{kind === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
