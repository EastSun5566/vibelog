---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { SITE_LANGUAGE, SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  kind?: "website" | "article";
  publishedAt?: Date;
  modifiedAt?: Date;
  tags?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  kind = "website",
  publishedAt,
  modifiedAt,
  tags = [],
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="stylesheet" href="/theme.css" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("/rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={kind} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={SITE_LANGUAGE} />
{
  kind === "article" && publishedAt && (
    <meta property="article:published_time" content={publishedAt.toISOString()} />
  )
}
{
  kind === "article" && modifiedAt && publishedAt && modifiedAt > publishedAt && (
    <meta property="article:modified_time" content={modifiedAt.toISOString()} />
  )
}
{kind === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
