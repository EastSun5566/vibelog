---
import { text } from "../localization";

const today = new Date();

interface Props {
  name: string;
  bio?: string;
  variant?: "minimal" | "profile";
}

const { name, bio = "", variant = "minimal" } = Astro.props;
---

<footer class={`site-footer variant-${variant}`} data-design-target="site.footer">
  <small>&copy; {today.getFullYear()} {name}</small>
  {variant === "profile" && bio && <p>{bio}</p>}
  <nav aria-label={text.footerNavigation}>
    <ul class="footer-links" role="list">
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/llms.txt">llms.txt</a></li>
    </ul>
  </nav>
</footer>
