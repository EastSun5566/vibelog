---
interface Tag {
  name: string;
  slug: string;
}

interface Props {
  tags: Tag[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list" role="list" aria-label="文章主題">
      {tags.map((tag) => (
        <li><a class="tag-link" href={`/tags/${tag.slug}/`}>{tag.name}</a></li>
      ))}
    </ul>
  )
}
