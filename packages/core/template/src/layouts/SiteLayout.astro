---
import { getCollection } from "astro:content";

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_LANGUAGE } from "../consts";
import { text } from "../localization";
import { design } from "../design";

interface Props {
  title: string;
  description: string;
  kind?: "website" | "article";
  publishedAt?: Date;
  modifiedAt?: Date;
  tags?: string[];
  articleTitle?: string;
  robots?: string;
  searchAssets?: boolean;
}

const { title, description, kind = "website", publishedAt, modifiedAt, tags, articleTitle, robots, searchAssets } = Astro.props;
const [authors, posts] = await Promise.all([
  getCollection("author"),
  getCollection("blog"),
]);
const [author] = authors;
const hasTags = posts.some((post) => post.data.tags.length > 0);
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
  <head>
    <BaseHead {title} {description} {kind} {publishedAt} {modifiedAt} {tags} {articleTitle} {robots} {searchAssets} authorName={author.data.name} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{text.skipToContent}</a>
    <Header {hasTags} variant={design.chrome.header.variant} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer name={author.data.name} bio={author.body} variant={design.chrome.footer.variant} />
  </body>
</html>
