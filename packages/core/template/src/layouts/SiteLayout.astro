---
import { getCollection } from "astro:content";

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_LANGUAGE } from "../consts";

interface Props {
  title: string;
  description: string;
  kind?: "website" | "article";
  publishedAt?: Date;
  modifiedAt?: Date;
  tags?: string[];
}

const { title, description, kind = "website", publishedAt, modifiedAt, tags } = Astro.props;
const [authors, posts] = await Promise.all([
  getCollection("author"),
  getCollection("blog"),
]);
const [author] = authors;
const hasTags = posts.some((post) => post.data.tags.length > 0);
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
  <head>
    <BaseHead {title} {description} {kind} {publishedAt} {modifiedAt} {tags} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要內容</a>
    <Header {hasTags} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer name={author.data.name} />
  </body>
</html>
