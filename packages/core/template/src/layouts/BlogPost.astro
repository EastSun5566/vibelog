---
import type { CollectionEntry } from "astro:content";

import FormattedDate from "../components/FormattedDate.astro";
import SiteLayout from "./SiteLayout.astro";
import { SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"] & {
  newerPost?: CollectionEntry<"blog">;
  olderPost?: CollectionEntry<"blog">;
};

const { title, description, date, updatedDate, newerPost, olderPost } = Astro.props;
---

<SiteLayout
  title={`${title} · ${SITE_TITLE}`}
  {description}
  kind="article"
  publishedAt={date}
>
  <article class="blog-post">
    <div class="blog-post-content">
      <header class="blog-post-header">
        <p class="blog-post-date"><FormattedDate date={date} /></p>
        <h1 class="blog-post-title">{title}</h1>
        {
          updatedDate && (
            <p class="blog-post-update">
              更新於 <FormattedDate date={updatedDate} />
            </p>
          )
        }
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>

  {
    (newerPost || olderPost) && (
      <nav class="article-navigation" aria-label="文章導覽">
        {newerPost ? (
          <a class="article-navigation-link newer" href={`/blog/${newerPost.id}/`}>
            <span>較新文章</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        ) : (
          <span />
        )}
        {olderPost && (
          <a class="article-navigation-link older" href={`/blog/${olderPost.id}/`}>
            <span>較舊文章</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        )}
      </nav>
    )
  }
</SiteLayout>
