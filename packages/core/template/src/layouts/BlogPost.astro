---
import type { CollectionEntry } from "astro:content";

import FormattedDate from "../components/FormattedDate.astro";
import TagList from "../components/TagList.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SiteLayout from "./SiteLayout.astro";
import { SITE_TITLE } from "../consts";

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

type Props = CollectionEntry<"blog">["data"] & {
  newerPost?: CollectionEntry<"blog">;
  olderPost?: CollectionEntry<"blog">;
  headings?: TocHeading[];
};

const { title, description, date, updatedDate, tags, newerPost, olderPost, headings = [] } = Astro.props;
const showUpdatedDate = updatedDate
  && updatedDate > date
  && updatedDate.toISOString().slice(0, 10) !== date.toISOString().slice(0, 10);
const showTableOfContents = headings.length >= 2;
---

<SiteLayout
  title={`${title} · ${SITE_TITLE}`}
  {description}
  kind="article"
  publishedAt={date}
  modifiedAt={updatedDate}
  tags={tags.map((tag) => tag.name)}
>
  <article class="blog-post">
    <div class="blog-post-content">
      <header class="blog-post-header" id="article-start">
        <p class="blog-post-date"><FormattedDate date={date} /></p>
        <h1 class="blog-post-title">{title}</h1>
        <TagList {tags} />
        {
          showUpdatedDate && (
            <p class="blog-post-update">
              更新於 <FormattedDate date={updatedDate} />
            </p>
          )
        }
      </header>
      {showTableOfContents && <TableOfContents {headings} />}
      <div class="prose">
        <slot />
      </div>
      {
        showTableOfContents && (
          <a class="article-back-to-start" href="#article-start">回到文章開頭</a>
        )
      }
    </div>
  </article>

  {
    (newerPost || olderPost) && (
      <nav class="article-navigation" aria-label="文章導覽">
        {newerPost ? (
          <a class="article-navigation-link newer" href={`/blog/${newerPost.id}/`}>
            <span>較新文章</span>
            <strong>{newerPost.data.title}</strong>
          </a>
        ) : (
          <span />
        )}
        {olderPost && (
          <a class="article-navigation-link older" href={`/blog/${olderPost.id}/`}>
            <span>較舊文章</span>
            <strong>{olderPost.data.title}</strong>
          </a>
        )}
      </nav>
    )
  }
</SiteLayout>
