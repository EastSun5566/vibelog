---
import { getCollection } from "astro:content";

import HomeSections from "../design/HomeSections.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { design } from "../design";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [author] = await getCollection("author");
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <HomeSections sections={design.pages.home.sections} {posts} {author} />
</SiteLayout>
