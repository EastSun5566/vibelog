---
import { getCollection, render } from "astro:content";

import PostList from "../components/PostList.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [author] = await getCollection("author");
const { Content: AuthorBio } = await render(author);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="home-hero" aria-labelledby="site-heading">
    <p class="eyebrow">{author.data.name}</p>
    <h1 id="site-heading">{SITE_TITLE}</h1>
    {SITE_DESCRIPTION && <p class="site-description">{SITE_DESCRIPTION}</p>}
    <div class="author-bio"><AuthorBio /></div>
  </section>

  <section class="latest-posts" aria-labelledby="latest-posts-heading">
    <div class="section-heading">
      <h2 id="latest-posts-heading">最新文章</h2>
      <a class="all-posts-link" href="/blog">查看所有文章</a>
    </div>
    <PostList posts={posts.slice(0, 5)} headingLevel="h3" />
  </section>
</SiteLayout>
