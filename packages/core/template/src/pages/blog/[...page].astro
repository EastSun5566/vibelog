---
import type { Page } from "astro";
import { type CollectionEntry, getCollection } from "astro:content";

import PostList from "../../components/PostList.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { text } from "../../localization";
import { design } from "../../design-v2";

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
  );
  return paginate(posts, { pageSize: 10 });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const pageTitle = page.currentPage === 1
  ? text.allPosts
  : `${text.allPosts} · ${text.pageLabel(page.currentPage)}`;
const canonicalArchivePath = (path: string) => path.endsWith("/") ? path : `${path}/`;
const index = design.pages.index;
const item = index.item;
---

<SiteLayout title={`${pageTitle} · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <header class="page-heading">
    <p class="eyebrow">{SITE_TITLE}</p>
    <h1>{text.allPosts}</h1>
    <p>{text.postsByDate(page.total)}</p>
  </header>
  <section class={`blog-index layout-${index.layout} columns-${index.columns}`} data-design-role="index-root">
    <PostList posts={page.data} variant={item.variant} columns={index.columns} showDescription={item.showDescription} showTags={item.showTags} />
  </section>
  {
    page.lastPage > 1 && (
      <nav class="archive-pagination" aria-label={text.pagination}>
        {page.url.prev ? <a href={canonicalArchivePath(page.url.prev)}>{text.previousPage}</a> : <span />}
        <span aria-current="page">{text.pageOf(page.currentPage, page.lastPage)}</span>
        {page.url.next ? <a href={canonicalArchivePath(page.url.next)}>{text.nextPage}</a> : <span />}
      </nav>
    )
  }
</SiteLayout>
