---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPostV2 from "../../layouts/BlogPostV2.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newerPost: posts[index - 1],
      olderPost: posts[index + 1],
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  newerPost?: CollectionEntry<"blog">;
  olderPost?: CollectionEntry<"blog">;
}

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await render(post);
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<BlogPostV2 {...post.data} postId={post.id} {newerPost} {olderPost} headings={tableOfContents}><Content /></BlogPostV2>
