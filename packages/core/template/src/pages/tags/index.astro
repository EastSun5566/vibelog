---
import { getCollection } from "astro:content";

import SiteLayout from "../../layouts/SiteLayout.astro";
import { SITE_LANGUAGE, SITE_TITLE } from "../../consts";
import { text } from "../../localization";

const posts = await getCollection("blog");
const tags = Array.from(posts.reduce((index, post) => {
  for (const tag of post.data.tags) {
    const existing = index.get(tag.slug);
    index.set(tag.slug, { ...tag, count: (existing?.count ?? 0) + 1 });
  }
  return index;
}, new Map<string, { name: string; slug: string; count: number }>()).values()).sort(
  (left, right) => right.count - left.count || left.name.localeCompare(right.name, SITE_LANGUAGE),
);
const description = text.browseTagsDescription(SITE_TITLE);
---

<SiteLayout title={`${text.tags} · ${SITE_TITLE}`} {description}>
  <header class="page-heading">
    <p class="eyebrow">{SITE_TITLE}</p>
    <h1>{text.tags}</h1>
    <p>{text.browseTags}</p>
  </header>
  {
    tags.length > 0 ? (
      <ul class="tag-index" role="list">
        {tags.map((tag) => (
          <li>
            <a class="tag-index-link" href={`/tags/${tag.slug}/`}>
              <span>{tag.name}</span>
              <span class="tag-count">{text.postCount(tag.count)}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">{text.noTags}</p>
    )
  }
</SiteLayout>
