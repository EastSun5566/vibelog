---
import { type CollectionEntry, getCollection } from "astro:content";

import PostList from "../../components/PostList.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { SITE_TITLE } from "../../consts";

interface Tag {
  name: string;
  slug: string;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tags = new Map<string, Tag>();
  for (const post of posts) {
    for (const tag of post.data.tags) if (!tags.has(tag.slug)) tags.set(tag.slug, tag);
  }
  return Array.from(tags.values()).map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.some((item) => item.slug === tag.slug))
        .sort((left, right) => right.data.date.valueOf() - left.data.date.valueOf()),
    },
  }));
}

interface Props {
  tag: Tag;
  posts: CollectionEntry<"blog">[];
}

const { tag, posts } = Astro.props;
const description = `${SITE_TITLE} 中關於「${tag.name}」的文章。`;
---

<SiteLayout title={`主題：${tag.name} · ${SITE_TITLE}`} {description}>
  <header class="page-heading">
    <p class="eyebrow"><a href="/tags">所有主題</a></p>
    <h1>{tag.name}</h1>
    <p>{posts.length} 篇文章，依發布日期由新到舊排列。</p>
  </header>
  <PostList {posts} />
</SiteLayout>
