---
import type { CollectionEntry } from 'astro:content';
import type { HomeSection } from '../../design';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
type Section = Extract<HomeSection, { type: 'intro' }>;
interface Props { section: Section; author: CollectionEntry<'author'> }
const { section, author } = Astro.props;
---
<section class={`home-section home-hero variant-${section.variant}`} data-design-target="home.intro" aria-labelledby="site-heading">
  {section.showAuthor && <p class="eyebrow">{author.data.name}</p>}
  <h1 id="site-heading">{SITE_TITLE}</h1>
  {SITE_DESCRIPTION && <p class="site-description">{SITE_DESCRIPTION}</p>}
</section>
