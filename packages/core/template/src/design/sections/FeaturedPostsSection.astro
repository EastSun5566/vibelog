---
import type { CollectionEntry } from 'astro:content';
import type { HomeSection } from '../../design';
import PostList from '../../components/PostList.astro';
import { text } from '../../localization';
type Section = Extract<HomeSection, { type: 'featured-posts' }>;
interface Props { section: Section; posts: CollectionEntry<'blog'>[] }
const { section, posts } = Astro.props;
---
{posts.length > 0 && <section class={`home-section featured-posts variant-${section.variant}`} aria-labelledby="featured-posts-heading">
  <div class="section-heading"><h2 id="featured-posts-heading">{text.featuredPosts}</h2></div>
  <PostList {posts} headingLevel="h3" variant={section.variant === 'split' ? 'cards' : 'divided'} columns={section.count} />
</section>}
