---
import type { CollectionEntry } from 'astro:content';
import type { HomeSection } from '../../design';
import PostList from '../../components/PostList.astro';
import { text } from '../../localization';
type Section = Extract<HomeSection, { type: 'recent-posts' }>;
interface Props { section: Section; posts: CollectionEntry<'blog'>[] }
const { section, posts } = Astro.props;
const variant = section.variant === 'list' ? 'divided' : 'cards';
---
<section class={`home-section recent-posts variant-${section.variant}`} aria-labelledby="latest-posts-heading">
  <div class="section-heading"><h2 id="latest-posts-heading">{text.latestPosts}</h2><a class="all-posts-link" href="/blog">{text.viewAllPosts}</a></div>
  <PostList {posts} headingLevel="h3" {variant} columns={section.columns} />
</section>
