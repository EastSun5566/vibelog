---
import type { CollectionEntry } from 'astro:content';
import type { HomeSection } from '../design';
import AuthorSection from './sections/AuthorSection.astro';
import FeaturedPostsSection from './sections/FeaturedPostsSection.astro';
import IntroSection from './sections/IntroSection.astro';
import RecentPostsSection from './sections/RecentPostsSection.astro';
import TopicsSection from './sections/TopicsSection.astro';

interface Props { sections: HomeSection[]; posts: CollectionEntry<'blog'>[]; author: CollectionEntry<'author'> }
const { sections, posts, author } = Astro.props;
const featured = sections.find((section) => section.type === 'featured-posts');
const featuredCount = featured?.type === 'featured-posts' ? featured.count : 0;
---

<div class="home-sections" data-design-target="home.sections">
  {sections.map((section) => {
    switch (section.type) {
      case 'intro': return <IntroSection section={section} {author} />;
      case 'featured-posts': return <FeaturedPostsSection section={section} posts={posts.slice(0, section.count)} />;
      case 'recent-posts': return <RecentPostsSection section={section} posts={posts.slice(featuredCount, featuredCount + section.limit)} />;
      case 'topics': return <TopicsSection section={section} {posts} />;
      case 'author': return <AuthorSection section={section} {author} />;
    }
  })}
</div>
