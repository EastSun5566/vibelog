{
  "name": "@vibelog/app",
  "version": "0.5.0-beta.2",
  "private": true,
  "description": "Hosted HackMD-to-Astro theme editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/vibelog.git",
    "directory": "packages/app"
  },
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=../../.env src/main.ts",
    "dev:server": "tsx --env-file=../../.env src/server.tsx",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/drizzle dist/drizzle",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "start": "node dist/main.js",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@vibelog/core": "workspace:*",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.30",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.19.4",
    "typescript": "7.0.2"
  }
}
