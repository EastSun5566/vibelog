{
  "name": "@vibelog/app",
  "version": "0.1.0",
  "description": "VibeLog App - Web API for blog generation",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/server.tsx",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@vibelog/core": "workspace:*",
    "hono": "^4.12.30",
    "openid-client": "6.8.4",
    "wrangler": "^4.110.0",
    "zod": "3.25.55"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
