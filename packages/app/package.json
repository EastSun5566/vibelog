{
  "name": "@vibelog/app",
  "version": "0.1.0",
  "private": true,
  "description": "VibeLog App - Web API for blog generation",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=../../.env src/server.tsx",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@vibelog/core": "workspace:*",
    "hono": "^4.12.30",
    "openid-client": "6.8.4",
    "wrangler": "^4.110.0",
    "zod": "3.25.55"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.4",
    "typescript": "7.0.2"
  }
}
