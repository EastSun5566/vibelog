{
  "name": "@vibelog/app",
  "version": "0.8.0",
  "private": true,
  "description": "Hosted HackMD-to-Astro theme editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/vibelog.git",
    "directory": "packages/app"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm css:build && tsx --env-file=../../.env src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/drizzle dist/drizzle && pnpm css:build --minify",
    "css:build": "tailwindcss -i src/styles/app.css -o dist/assets/app.css",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "start": "node dist/web-main.js",
    "start:worker": "node dist/worker-main.js",
    "db:migrate": "node dist/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@google-cloud/tasks": "7.0.0",
    "@hono/node-server": "^1.19.15",
    "@vibelog/core": "workspace:*",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.34",
    "pg": "8.23.0",
    "resend": "6.25.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "basecoat-css": "1.0.2",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.4",
    "typescript": "7.0.2"
  }
}
