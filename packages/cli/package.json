{
  "name": "vibelog",
  "version": "0.4.1-beta.9",
  "description": "Bring your own content with some vibes ✨ - CLI tool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/vibelog.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "vibelog": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "keywords": [
    "blog-builder",
    "content",
    "markdown",
    "vibe",
    "ai",
    "styling",
    "cli"
  ],
  "author": "Michael Wang <michael19920327@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@vibelog/core": "workspace:*",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.4",
    "typescript": "7.0.2"
  }
}
