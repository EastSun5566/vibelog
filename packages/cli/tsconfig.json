{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "docs/.vitepress/**/*.ts",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "coverage"]
}
