---
import { getCollection } from 'astro:content';
import Base from '../layouts/base.astro';

const posts = await getCollection('blog');
---

<Base title="Welcome">
  <h1>Welcome to my site</h1>
  
  <h2>Posts:</h2>
  <ul>
    {posts.map(post => (
      <li>
        <h3>{post.data.title}</h3>
        <p>{post.body}</p>
      </li>
    ))}
  </ul>
</Base>
